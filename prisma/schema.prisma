generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Celebration {
  id             String   @id @default(cuid())
  slug           String   @unique
  organizerId    String?
  category       String   @default("birthday")
  customCategory String?
  celebrant      String
  title          String
  deadline       String?
  createdAt      DateTime @default(now())

  submissions Submission[]
  finalVideo  FinalVideo?

  @@index([organizerId])
}

model Submission {
  id            String   @id @default(cuid())
  celebrationId String
  name          String
  message       String?
  videoUrl      String
  approved      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  celebration Celebration @relation(fields: [celebrationId], references: [id])
}

model FinalVideo {
  id            String   @id @default(cuid())
  celebrationId String   @unique
  videoUrl      String
  createdAt     DateTime @default(now())

  celebration Celebration @relation(fields: [celebrationId], references: [id])
}
